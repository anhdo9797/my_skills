# Template for this project's environment file, committed with empty values.
#
# This example keeps it at fastlane/.env.prod, which is the layout Fastlane
# loads for free with `--env prod`. Projects that keep env at the repository
# root or under config/ put the same names there instead and export the file
# into the job environment in CI — see references/env-layouts.md.
#
# Copy this file, fill in real values locally, and keep the result out of git.
# In CI it travels as one base64 variable, decoded back to the same path.
# Every value below is a placeholder.

# --- Build selection -------------------------------------------------------
FLAVOR=prod
BUNDLE_IDENTIFIER=com.example.app

# --- iOS distribution ------------------------------------------------------
APPLE_ID=
APPLE_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
# Base64 or escaped contents of the .p8 key. CI only.
ASC_KEY_CONTENT=
# Password for the temporary CI keychain.
KEYCHAIN_PASSWORD=
CERT_PASSWORD=

# --- Android distribution --------------------------------------------------
FIREBASE_APP_ID=
FIREBASE_TOKEN=
GROUP_TESTERS=

# --- Release page identity -------------------------------------------------
APP_NAME=Example App
APP_EMOJI=🚀
# Optional; defaults to APP_NAME.
RELEASE_PAGE_TITLE=

# --- Notion ----------------------------------------------------------------
# Secret. Internal integration token.
NOTION_API_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_TASK_DATA_SOURCE_ID=
NOTION_BUG_DATA_SOURCE_ID=
NOTION_TITLE_PROPERTY_ID=title
NOTION_ASSIGNEE_PROPERTY_NAMES_JSON=["Assignee","Assignee to"]

# --- Discord ---------------------------------------------------------------
# Secret. Channel webhook URL.
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Release Bot
DISCORD_AVATAR_URL=
DISCORD_ASSIGNEE_MAP_JSON={"Example User":"100000000000000001"}
DISCORD_RELEASE_NOTES_LABEL=📋 Release notes
DISCORD_TASK_ASSIGNED_LABEL=👥 Task assigned
DISCORD_BACKLOG_LABEL=📌 Backlog
DISCORD_ACTION_REQUIRED_TEXT=✅ Vui lòng xác minh các task được giao trước khi gửi bản build cho QC.
DISCORD_UNASSIGNED_FALLBACK=Chưa phân công
